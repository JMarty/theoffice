# Copy to a file outside the repo, mode 0600, and point the unit's EnvironmentFile at it. Nothing here is a secret by itself,
# but the Google client secret lives in the file named by OFFICE_MCP_GOOGLE_CLIENT_SECRET_FILE (0600, never in the repo).
OFFICE_TENANT_ROOT=/path/to/your/tenant
OFFICE_MCP_HOST=127.0.0.1
OFFICE_MCP_PORT=3441
OFFICE_MCP_ALLOW=127.0.0.1
OFFICE_MCP_PUBLIC_URL=https://mcp.example.com
OFFICE_MCP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
OFFICE_MCP_GOOGLE_CLIENT_SECRET_FILE=/path/to/secret-file
OFFICE_MCP_ROUTING_FILE=/path/to/routing.json
OFFICE_MCP_PROFILES_FILE=/path/to/profiles.json
OFFICE_MCP_SEND_PER_MIN=20
OFFICE_MCP_SEND_PER_DAY=0
