[Unit]
Description=Off-box code sync: push every own git repo to its GitHub origin (no force), scan for secrets, write store/offsite-code.json, alert only on problems

[Service]
Type=oneshot
Environment=OFFICE_TENANT_ROOT=@TENANT@
ExecStart=/usr/bin/python3 @ROOT@/tools/offsite-sync/offsite_sync.py
TimeoutStartSec=1800
